pipeline {
    agent any

    environment {
        DOCKER_HUB_REPO = 'azizos07/vital-signs-service'
        SERVICE_NAME     = 'vital-signs-service'
        NAMESPACE        = 'pedinephro'
        SONAR_HOST       = 'http://172.17.0.2:9000'
        KUBECONFIG       = '/var/lib/jenkins/kubeconfig'
    }

    stages {

        stage('Verify Cluster') {
            steps {
                sh 'kubectl get nodes'
            }
        }

        stage('Checkout K8s') {
            steps {
                cleanWs()
                git url: 'https://github.com/pediNephro/kubernetes-config.git',
                    branch: 'master'
            }
        }

        stage('Sonar Quality Gate') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        STATUS=$(curl -s -u ${SONAR_TOKEN}: \
                        "${SONAR_HOST}/api/qualitygates/project_status?projectKey=${SERVICE_NAME}" \
                        | grep -o '"status":"[^"]*"' | head -1 | cut -d'"' -f4)

                        echo "Quality Gate Status: $STATUS"
                        if [ "$STATUS" != "OK" ]; then
                            echo "⚠️ Quality Gate FAILED — continuing"
                        fi
                    '''
                }
            }
        }

        stage('Verify Image') {
            steps {
                sh 'docker pull ${DOCKER_HUB_REPO}:latest'
            }
        }

        stage('Deploy Vital Signs Service') {
            steps {
                sh '''
                    echo "=== YAML ==="
                    cat 10-vital-signs-service.yaml

                    echo "=== Validation ==="
                    grep -n tcpSocket 10-vital-signs-service.yaml && echo "FOUND BUG" || echo "OK"

                    kubectl replace --force -f 10-vital-signs-service.yaml -n ${NAMESPACE}
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    kubectl rollout status deployment/${SERVICE_NAME} -n ${NAMESPACE} --timeout=300s

                    echo "=== Pods ==="
                    kubectl get pods -n ${NAMESPACE} -l app=${SERVICE_NAME}

                    echo "=== Services ==="
                    kubectl get svc -n ${NAMESPACE}
                '''
            }
        }
    }

    post {
        failure {
            sh '''
                echo "❌ Deployment failed — debug:"

                kubectl get pods -n ${NAMESPACE} -l app=${SERVICE_NAME}
                kubectl logs -n ${NAMESPACE} -l app=${SERVICE_NAME} --tail=50 || true
                kubectl describe pods -n ${NAMESPACE} -l app=${SERVICE_NAME} || true
            '''
        }
        success {
            echo "✅ Deployment SUCCESS"
        }
    }
}